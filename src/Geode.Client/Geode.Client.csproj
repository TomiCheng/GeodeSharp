<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Geode.Client</RootNamespace>
    <AssemblyName>Geode.Client</AssemblyName>
    <PackageId>Geode.Client</PackageId>

    <!-- 這個專案是要打包成 NuGet 的 -->
    <IsPackable>true</IsPackable>

    <!-- MinVer：版本號從 git tag 推導 (例如 tag v0.1.0-alpha → 0.1.0-alpha) -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>1701;1702;CA1873</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="D:\projects\tomi\GeodeSharp\README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />

    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Geode.Client.Tests" />
    <InternalsVisibleTo Include="Geode.Client.IntegrationTests" />
  </ItemGroup>

</Project>
